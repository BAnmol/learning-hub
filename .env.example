# Copy this file to .env and fill in your own values.
# .env itself is expected to be a local, un-committed file.

# --- Default platform usernames shown before a user connects their own handles ---
LEETCODE_USERNAME=lee215
CODECHEF_USERNAME=tourist
CODEFORCES_USERNAME=tourist

# --- Supabase Cloud Database (Optional — falls back to local SQLite if blank) ---
# Create a free project at https://supabase.com and copy your project URL & API key
SUPABASE_URL=
SUPABASE_KEY=
# Service Role key (optional, for admin migration scripts)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Providers — power the "Ask AI" mentor chat, problem explanations,
# AI code review, and the mock-interview engine. Trending AI News does NOT
# use any of these — it's free/keyless (arXiv + Hacker News) and always on.
#
# All three below are read by src/llm_router.py, which tries them IN ORDER
# (OpenRouter -> Groq -> Gemini) and automatically falls through to the next
# one if a provider is down, rate-limited, or simply not configured. You only
# need ONE key for AI features to work — add the others too so a single
# provider outage never interrupts your work.

# Tier 1: OpenRouter — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# openrouter/free auto-routes across OpenRouter's pool of $0 models (extra
# fallback models are hardcoded in src/llm_router.py). Swap to a paid model
# (e.g. openai/gpt-4o-mini) once you've added credits at
# https://openrouter.ai/settings/credits for higher quality/reliability.
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_SITE_NAME=Brainfreeze Algos

# Tier 2: Groq — free, very fast inference, OpenAI-compatible API.
# Get a free key at https://console.groq.com/keys (no credit card required).
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Tier 3: Google Gemini — separate infrastructure from the two above, so it
# keeps working even if both OpenRouter and Groq are having an outage at the
# same time. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Deployment ---
# A long random string — required in production (sessions/cookies are signed with it).
SECRET_KEY=replace-with-a-long-random-string-in-production
# Optional: separate key used to encrypt each user's Notion integration token
# at rest (src/notion_engine.py). Falls back to SECRET_KEY if left blank —
# set a dedicated value in production so rotating SECRET_KEY doesn't also
# invalidate every stored Notion token.
NOTION_ENCRYPTION_KEY=
# Bind address: 127.0.0.1 for local-only, 0.0.0.0 to accept traffic on most hosts/containers.
HOST=127.0.0.1
PORT=5000
# Never enable the Werkzeug debugger/reloader in a publicly reachable deployment.
FLASK_DEBUG=false
